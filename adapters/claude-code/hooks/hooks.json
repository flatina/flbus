{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "flbus remote daemon", "timeout": 10 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "flbus notify", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "flbus guard", "timeout": 10 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "flbus reap", "timeout": 10 }
        ]
      }
    ]
  }
}
